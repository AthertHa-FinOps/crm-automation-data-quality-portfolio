        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: \"email\", operator: \"EQ\", value: $json.lead.email }] }], properties: [\"email\",\"firstname\",\"lastname\"], limit: 1 }) }}",
        "options": {}
      },
