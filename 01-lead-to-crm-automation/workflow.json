    {
      "parameters": {
        "jsCode": "// Validate + normalize incoming lead. Output: { valid, errors[], lead{}, received_at }\nconst b = $input.first().json.body ?? $input.first().json;\nconst errors = [];\nconst email = String(b.email ?? '').trim().toLowerCase();\nif (!email) errors.push('MISSING_EMAIL');\nelse if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push('INVALID_EMAIL');\nconst digits = String(b.phone ?? '').replace(/\\D/g, '');\nconst p = digits.length === 11 && digits[0] === '1' ? digits.slice(1) : digits;\nconst phone = p.length === 10 ? `${p.slice(0,3)}-${p.slice(3,6)}-${p.slice(6)}` : '';\nif (b.phone && !phone) errors.push('INVALID_PHONE');\nconst cap = s => String(s ?? '').trim().replace(/\\s+/g,' ').replace(/\\b\\w/g, c => c.toUpperCase());\nconst lead = { email, firstname: cap(b.first_name), lastname: cap(b.last_name), phone,\n  hs_lead_status: 'NEW', lead_source: String(b.lead_source ?? 'Unknown').trim(),\n  message: String(b.message ?? '').slice(0, 500) };\nreturn [{ json: { valid: errors.length === 0, errors, lead, received_at: new Date().toISOString() } }];"
      },
      "id": "validate-&-normalize",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valid }}",
              "value2": true
            }
